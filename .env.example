# Copy to .env for local development (never commit the real .env).
# In production, pass these via your MCP client's "env" block instead.

# Base URL of your YouTrack instance (no trailing /api).
YOUTRACK_URL=https://your-youtrack.example.com

# A YouTrack permanent token: Profile -> Account Security -> New token...
YOUTRACK_TOKEN=perm-XXXXXXXX.YYYYYYYY.ZZZZZZZZ
